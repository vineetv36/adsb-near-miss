# ─── OpenSky Network API ───
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ─── Kafka ───
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── PostgreSQL ───
POSTGRES_DB=adsb
POSTGRES_USER=adsb
POSTGRES_PASSWORD=adsb_secret
DATABASE_URL=postgresql://adsb:adsb_secret@postgres:5432/adsb

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── Ingestion ───
POLL_INTERVAL_SECONDS=10
BOUNDING_BOX=24.396,-125.0,49.384,-66.934
